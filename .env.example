# Copy to .env and fill in; never commit real values.
SCIENCEPAL_API_KEY=
# SCIENCEPAL_BASE_URL=            # optional, defaults to the public SciencePal API
OAE_LLM_BASE_URL=                 # OpenAI-compatible endpoint for the proposer model (DeepSeek-V4-Flash in our runs)
OAE_LLM_API_KEY=
OAE_LLM_MODEL=deepseek-v4-flash
OPENARCHEVO_DIR=../OpenArchEvo    # checkout of github.com/Optima-CityU/OpenArchEvo
OAE_LABS_JSON=config/labs.json    # {lab_name: SciencePal thread id of a GPU sandbox lab}; see config/labs.example.json
# SKILL_MD_PATH=skills/v0.7.0/SKILL.md   # proposer Skill (defaults to v0.7.0)
# OAE_SKILL_DIR=skills/runtime           # proposer runtime: CPU check, functional-equivalence check, parent library
